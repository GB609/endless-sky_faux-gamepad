<?xml version="1.0" encoding="UTF-8"?>
<gamecontroller configversion="19" appversion="3.6.1">
    <!--The SDL name for a joystick is included for informational purposes only.-->
    <sdlname>HyperX Clutch</sdlname>
    <!--The Unique ID for a joystick is included for informational purposes only.-->
    <uniqueID>0300b18cf00300008d0400000101000010081165V148202110081</uniqueID>
    <stickAxisAssociation index="1" xAxis="1" yAxis="2"/>
    <stickAxisAssociation index="2" xAxis="3" yAxis="4"/>
    <vdpadButtonAssociations index="1">
        <vdpadButtonAssociation axis="0" button="12" direction="1"/>
        <vdpadButtonAssociation axis="0" button="13" direction="4"/>
        <vdpadButtonAssociation axis="0" button="14" direction="8"/>
        <vdpadButtonAssociation axis="0" button="15" direction="2"/>
    </vdpadButtonAssociations>
    <names>
        <controlstickname index="1">L Stick</controlstickname>
        <controlstickname index="2">R Stick</controlstickname>
    </names>
    <sets>
        <set index="1">
            <trigger index="6">
                <throttle>positivehalf</throttle>
            </trigger>
            <trigger index="5">
                <throttle>positivehalf</throttle>
            </trigger>
            <button index="10">
                <actionname>R / *Set2</actionname>
                <slots>
                    <slot>
                        <code>400</code>
                        <mode>hold</mode>
                    </slot>
                    <slot>
                        <code>1</code>
                        <mode>setchange</mode>
                    </slot>
                    <slot>
                        <code>600000</code>
                        <mode>pause</mode>
                    </slot>
                    <slot>
                        <code>10</code>
                        <mode>release</mode>
                    </slot>
                    <slot>
                        <code>0x52</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>390</code>
                        <mode>release</mode>
                    </slot>
                </slots>
            </button>
            <button index="11">
                <actionname>n / *j</actionname>
                <slots>
                    <slot>
                        <code>400</code>
                        <mode>hold</mode>
                    </slot>
                    <slot>
                        <code>0x4a</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>10</code>
                        <mode>release</mode>
                    </slot>
                    <slot>
                        <code>0x4e</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>390</code>
                        <mode>release</mode>
                    </slot>
                </slots>
            </button>
        </set>
        <set index="2">
            <trigger index="6">
                <throttle>positivehalf</throttle>
            </trigger>
            <trigger index="5">
                <throttle>positivehalf</throttle>
            </trigger>
            <button index="10">
                <actionname>Back to Set1</actionname>
                <slots>
                    <slot>
                        <code>100</code>
                        <mode>release</mode>
                    </slot>
                    <slot>
                        <code>0</code>
                        <mode>setchange</mode>
                    </slot>
                </slots>
            </button>
        </set>
    </sets>
</gamecontroller>
